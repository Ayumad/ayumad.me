{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/dashboard",
      "destination": "/api/dashboard?view=%2Fdashboard"
    },
    {
      "source": "/status",
      "destination": "/api/dashboard?view=%2Fstatus"
    },
    {
      "source": "/status/data",
      "destination": "/api/dashboard?view=status-data"
    },
    {
      "source": "/dashboard/login",
      "destination": "/api/dashboard?view=login"
    },
    {
      "source": "/dashboard/logout",
      "destination": "/api/dashboard?view=logout"
    },
    {
      "source": "/dashboard/data",
      "destination": "/api/dashboard?view=data"
    },
    {
      "source": "/vault",
      "destination": "https://ayumad.github.io/ayumad.vault/"
    },
    {
      "source": "/vault/",
      "destination": "https://ayumad.github.io/ayumad.vault/"
    },
    {
      "source": "/vault/:path*/",
      "destination": "https://ayumad.github.io/ayumad.vault/:path*/"
    },
    {
      "source": "/vault/:path*",
      "destination": "https://ayumad.github.io/ayumad.vault/:path*"
    },
    {
      "source": "/ai",
      "destination": "https://ayumad.github.io/AI-Engineering-Curriculum/"
    },
    {
      "source": "/ai/",
      "destination": "https://ayumad.github.io/AI-Engineering-Curriculum/"
    },
    {
      "source": "/ai/:path*/",
      "destination": "https://ayumad.github.io/AI-Engineering-Curriculum/:path*/"
    },
    {
      "source": "/ai/:path*",
      "destination": "https://ayumad.github.io/AI-Engineering-Curriculum/:path*"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "base-uri 'self'; frame-ancestors 'self'; object-src 'none'"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://cdn.jsdelivr.net https://i.scdn.co https://*.ts.net; worker-src 'self' blob:"
        }
      ]
    }
  ],
  "functions": {
    "api/dashboard.ts": {
      "includeFiles": "server/dashboard/**"
    }
  },
  "redirects": [
    {
      "source": "/dashboard/hermes",
      "destination": "/status",
      "permanent": false
    },
    {
      "source": "/dashboard/homelab",
      "destination": "/status",
      "permanent": false
    },
    {
      "source": "/ai/",
      "destination": "/ai",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.ayumad.me"
        }
      ],
      "destination": "https://ayumad.me/:path*",
      "permanent": true
    },
    {
      "source": "/writeups/:slug",
      "destination": "/journal/:slug",
      "permanent": true
    },
    {
      "source": "/writeups",
      "destination": "/journal",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/journal",
      "permanent": true
    },
    {
      "source": "/hermes",
      "destination": "/projects/hermes-agent",
      "permanent": true
    },
    {
      "source": "/showcase",
      "destination": "/projects",
      "permanent": true
    },
    {
      "source": "/systems",
      "destination": "/projects",
      "permanent": true
    },
    {
      "source": "/now",
      "destination": "/projects",
      "permanent": true
    },
    {
      "source": "/taste",
      "destination": "/about#taste",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/about#contact",
      "permanent": true
    },
    {
      "source": "/projects/hermes",
      "destination": "/projects/hermes-agent",
      "permanent": true
    },
    {
      "source": "/projects/daily-brief",
      "destination": "/projects/hermes-agent",
      "permanent": true
    },
    {
      "source": "/projects/owlbot",
      "destination": "/projects",
      "permanent": true
    },
    {
      "source": "/projects/delulubot",
      "destination": "/projects",
      "permanent": true
    },
    {
      "source": "/projects/audio-visualization",
      "destination": "/projects",
      "permanent": true
    }
  ]
}
