{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/vault",
      "destination": "https://ayumad.github.io/ayumad.vault/"
    },
    {
      "source": "/vault/",
      "destination": "https://ayumad.github.io/ayumad.vault/"
    },
    {
      "source": "/vault/:path*/",
      "destination": "https://ayumad.github.io/ayumad.vault/:path*/"
    },
    {
      "source": "/vault/:path*",
      "destination": "https://ayumad.github.io/ayumad.vault/:path*"
    },
    {
      "source": "/ai",
      "destination": "https://ayumad.github.io/AI-Engineering-Curriculum/"
    },
    {
      "source": "/ai/",
      "destination": "https://ayumad.github.io/AI-Engineering-Curriculum/"
    },
    {
      "source": "/ai/:path*/",
      "destination": "https://ayumad.github.io/AI-Engineering-Curriculum/:path*/"
    },
    {
      "source": "/ai/:path*",
      "destination": "https://ayumad.github.io/AI-Engineering-Curriculum/:path*"
    },
    {
      "source": "/((?!api).*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
